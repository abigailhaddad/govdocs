# Cloudflare R2 — where the documents are kept.
CF_R2_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=govdocs

# api.data.gov keys. Free, one minute to get: https://api.data.gov/signup/
# SAM_API_KEY reads the Opportunities API; DATAGOV_API_KEY reads the FOIA
# component directory. The same key works for both.
SAM_API_KEY=
DATAGOV_API_KEY=

# Hugging Face write token, for pushing the datasets.
HF_TOKEN=
